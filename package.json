{
  "name": "aqua-calendar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@aqua-calendar/web --filter=@aqua-calendar/apis",
    "dev:frontend": "turbo dev --filter=@aqua-calendar/web",
    "dev:api": "turbo dev --filter=@aqua-calendar/apis",
    "dev:ai": "cd backend/ai && uv run python -m src.main",
    "dev:notification": "turbo dev --filter=@aqua-calendar/notification-delivery --filter=@aqua-calendar/notification-worker",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:reset": "turbo run db:migrate:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "turbo": "^2.8.8",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=20"
  }
}
