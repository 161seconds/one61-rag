# ============================================
# HKT AI Service - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Groq API ---
# Multiple keys for rotation (comma-separated)
GROQ_API_KEYS=
GEMINI_API_KEY=
# --- Model Configuration ---
MAIN_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
FALLBACK_MODEL=gpt-oss-120b

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hkt_rag

# --- Postgres (shared DB with BE) ---
DATABASE_URL=postgresql://aqua_calendar:aqua_calendar@localhost:5979/aqua_calendar_db

# --- BE Callback ---
CALLBACK_URL=http://localhost:3002/conversations/ai/response

# --- BullMQ (BE job queue) ---
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6380
BULLMQ_REDIS_PASSWORD=password

# --- Redis (AI cache) ---
REDIS_URL=redis://localhost:6382/0
CACHE_TTL_SECONDS=3600

# --- LightRAG ---
LIGHTRAG_WORKING_DIR=./data/lightrag_storage

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info
AI_DEBUG=false

# --- Anti-Hallucination ---
CONFIDENCE_THRESHOLD=0.7
GROUNDEDNESS_THRESHOLD=0.5
