		"@aws-sdk/s3-request-presigner": "^3.1027.0",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.0.1",
