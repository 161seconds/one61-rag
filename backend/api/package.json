		"eslint": "^9.18.0",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
