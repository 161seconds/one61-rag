PORT=3002
NODE_ENV=development
CORS_ORIGIN_1=http://localhost:5173
DATABASE_URL=postgresql://aqua_calendar:aqua_calendar@localhost:5979/aqua_calendar_db

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASS=password
REDIS_URL=redis://default:password@localhost:6380
REDIS_DEFAULT_TTL=3600

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Can be either account endpoint or include trailing `/<bucket>` (we normalize for signing).
R2_ENDPOINT=
R2_BUCKET=
# Optional explicit public base URL (recommended). Example:
# R2_PUBLIC_BASE_URL=https://pub-<your-public-bucket-id>.r2.dev
# or: R2_PUBLIC_BASE_URL=https://<accountId>.r2.cloudflarestorage.com/<bucket>
R2_PUBLIC_BASE_URL=
