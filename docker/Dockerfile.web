# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.0.6 --activate
WORKDIR /app

FROM base AS pruner
COPY . .
RUN --mount=type=cache,id=pnpm-dlx,target=/root/.local/share/pnpm/store \
  pnpm dlx turbo@2.8.8 prune @aqua-calendar/web --docker

FROM base AS build
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-web,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
ARG VITE_API_BASE_URL=http://localhost:3002
ARG VITE_FIREBASE_VAPID_KEY=
ARG VITE_DEV=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY
ENV VITE_DEV=$VITE_DEV
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
ENV NODE_ENV=production
RUN --mount=type=cache,id=pnpm-web,target=/root/.local/share/pnpm/store \
  --mount=type=cache,id=turbo-web,target=/app/.turbo \
  pnpm exec turbo run build --filter=@aqua-calendar/web...

FROM nginx:1.27-alpine AS runner
COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
