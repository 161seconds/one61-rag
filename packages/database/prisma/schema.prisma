generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  google
}

enum UserStatus {
  active
  pending
  suspended
  deleted
}

model User {
  id String @id @default(uuid())

  email        String  @unique
  photoURL     String? @map("photo_url")
  displayName  String  @map("display_name")
  passwordHash String? @map("password_hash")

  authProvider AuthProvider?

  status UserStatus @default(pending)

  timeZone String? @default("Asia/Ho_Chi_Minh") @map("time_zone")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  notificationSettings NotificationSetting[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  events               Event[]

  conversationMembers ConversationMember[]
  messagesSent          Message[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum EventType {
  task
  event
  reminder
}

enum EventStatus {
  todo
  in_progress
  done
  cancelled
}

model Event {
  id     String @id @default(uuid())
  userId String @map("user_id")

  title       String  @map("title")
  description String? @map("description")

  eventType EventType    @map("event_type")
  status    EventStatus? @map("status")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  reminderAt DateTime? @map("reminder_at")

  metadata Json? @map("metadata")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("events")
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  eventId String @map("event_id")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  content Json @map("content")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("notifications")
}

enum NotificationChannel {
  email
  in_app
  browser
}

model NotificationSetting {
  id     String @id @default(cuid())
  userId String @map("user_id")

  channel NotificationChannel @map("channel")

  enabled Boolean @default(true) @map("enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel], name: "unique_notification_setting")
  @@index([userId])
  @@map("notification_settings")
}

enum NotificationDeliveryStatus {
  pending
  delivered
  failed
}

model NotificationDelivery {
  id             String @id @default(cuid()) @db.VarChar(30)
  notificationId String @map("notification_id") @db.VarChar(30)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(pending) @map("status")

  retryCount Int @default(0) @map("retry_count")
  maxRetries Int @default(5) @map("max_retries")

  lastError   String?   @map("last_error") @db.VarChar(255)
  lastRetryAt DateTime? @map("last_retry_at") @db.Timestamptz
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_deliveries")
}

model BrowserSubscription {
  id     String @id @default(cuid())
  userId String @map("user_id")

  browser String @map("browser")
  token   String @map("token")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, browser, token], name: "unique_browser_subscription")
  @@map("browser_subscriptions")
}

model Conversation {
  id        String   @id @default(uuid())
  type      ConversationType
  title     String?  @map("title")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

enum ConversationType {
  direct
  group
  ai
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  userId         String @map("user_id")
  role           ConversationMemberRole @default(member)
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

enum ConversationMemberRole {
  member
  admin
  bot
}

model Message {
  id             String @id @default(uuid())
  conversationId String @map("conversation_id")
  senderId       String? @map("sender_id")

  author      MessageAuthor @default(user) @map("author")
  contentType MessageContentType @map("content_type")

  content Json

  status    MessageStatus @default(sent) @map("status")
  createdAt DateTime      @default(now()) @map("created_at")

  messageMetadata MessageMetadata[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

enum MessageAuthor {
  user
  assistant
  system
}

enum MessageContentType {
  text
  multimodal_text
}

enum MessageStatus {
  sending
  sent
  delivered
  read
}

model MessageMetadata {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  key       String
  value     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, key])
  @@index([messageId])
  @@map("message_metadata")
}
