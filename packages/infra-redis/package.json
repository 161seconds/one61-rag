{
  "name": "@aqua-calendar/infra-redis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aqua-calendar/typescript-config": "workspace:*",
    "@aqua-calendar/env": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "ioredis": "^5.10.1",
    "@nestjs/bullmq": "^11.0.4",
    "cache-manager": "^7.0.0",
    "superjson": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
