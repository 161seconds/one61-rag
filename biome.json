{
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 3
  },
  "files": {
    "includes": [
      "frontend/**/*.{ts,tsx,js,jsx,json}",
      "backend/**/*.{ts,tsx,js,jsx,json}",
      "packages/**/*.{ts,tsx,js,jsx,json}",
      "*.{ts,tsx,js,jsx,json}",
      "!dist",
      "!**/dist"
    ],
    "ignoreUnknown": true
  }
}
